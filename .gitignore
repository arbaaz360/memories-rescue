# Rust
/target/
**/*.rs.bk
*.pdb

# Node / Vite
node_modules/
/dist/
*.local
npm-debug.log*

# Tauri
/src-tauri/target/
/src-tauri/gen/schemas/
/src-tauri/WixTools/

# Generated test fixtures (python tools/make_fixture)
/fixtures/

# Third-party sidecar binaries (python tools/sidecars.py fetch); the README is tracked
/third_party/*
!/third_party/README.md
# The minimal LGPL ffmpeg build recipe and its compliance texts are tracked;
# downloads, build trees and staged binaries are not.
!/third_party/ffmpeg/
/third_party/ffmpeg/*
!/third_party/ffmpeg/build.sh
!/third_party/ffmpeg/README.md
!/third_party/ffmpeg/COPYING.LGPLv2.1
!/third_party/ffmpeg/LICENSE-ffmpeg.md
!/third_party/ffmpeg/SOURCE_OFFER.txt
!/third_party/ffmpeg/PUBLISHING.md
/src-tauri/binaries/

# Python
__pycache__/
*.pyc
.venv/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# UI verification screenshots (scripts/ui-verify.mjs); published on the pr-assets branch, not here
/docs/ui/screenshots/
