{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. M1: core plus the two sidecars (ffmpeg, exiftool), each limited to the exact arguments the app sends. No shell open or spawn of anything else, no http, no fs, no dialog. Widen per feature.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": [
            "-version"
          ]
        },
        {
          "name": "binaries/exiftool",
          "sidecar": true,
          "args": [
            "-ver"
          ]
        }
      ]
    }
  ]
}
