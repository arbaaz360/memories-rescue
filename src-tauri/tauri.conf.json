{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memories Rescue",
  "version": "0.1.0",
  "identifier": "com.novabyteworks.memoriesrescue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Memories Rescue",
        "width": 1000,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "NovaByteWorks",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/exiftool"
    ],
    "resources": {
      "binaries/exiftool_files/": "exiftool_files/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
